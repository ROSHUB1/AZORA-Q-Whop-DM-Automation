# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Whop API Key: Used by backend to authenticate with Whop API (e.g. apik_...)
WHOP_API_KEY=""

# Whop Webhook Secret: Used to cryptographically verify incoming webhook signatures
WHOP_WEBHOOK_SECRET=""

# Whop Company / Experience ID (Optional identifier for agency workspace)
WHOP_COMPANY_ID=""

# Database connection URL or storage path
DATABASE_URL=""

